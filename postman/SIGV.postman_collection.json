    {
      "name": "Visites",
      "item": [
        {
          "name": "Créer une visite (depuis le scan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const v = pm.response.json();",
                  "pm.environment.set('visit_id', v.id);",
                  "pm.test('visite ouverte', () => pm.expect(v.statut).to.eql('PRESENT'));",
                  "pm.test('identité et NIN persistés', () => {",
                  "  pm.expect(v.visitor.numero_document).to.eql(pm.environment.get('visitor_numero_document'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visitor\": {\n    \"prenom\": \"{{visitor_prenom}}\",\n    \"nom\": \"{{visitor_nom}}\",\n    \"type_document\": \"{{type_document}}\",\n    \"numero_document\": \"{{visitor_numero_document}}\",\n    \"nin\": \"{{visitor_nin}}\",\n    \"nationalite\": \"{{visitor_nationalite}}\",\n    \"date_naissance\": \"{{visitor_date_naissance}}\",\n    \"sexe\": \"{{visitor_sexe}}\",\n    \"date_expiration_document\": \"{{visitor_date_expiration}}\",\n    \"telephone\": \"+221770000000\",\n    \"provenance\": \"Entreprise ACME\",\n    \"mrz_image_url\": \"{{mrz_image_url}}\"\n  },\n  \"service_id\": \"{{service_id}}\",\n  \"agent_id\": \"{{agent_id}}\",\n  \"purpose_id\": \"{{purpose_id}}\",\n  \"badge_number\": \"B-042\",\n  \"signature_url\": \"{{signature_url}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/visits",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "visits"
              ]
            },
            "description": "Reprend les variables alimentées par **OCR / Scan MRZ** et les référentiels.\n\nUn motif est obligatoire : `purpose_id` **ou** `motif_libre`."
          }
        },
