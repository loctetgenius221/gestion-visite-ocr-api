# Configuration de **développement local**. Copiez ce fichier en `.env`.
# Pour un déploiement sur VPS, partez plutôt de `.env.production.example`.
# Ne committez JAMAIS le fichier `.env` : il contient des secrets réels.

# --- Général ---
PROJECT_NAME="SIGV Backend"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Logs structurés JSON ; passez à false pour un format lisible en dev local.
LOG_JSON=true

# --- Base de données ---
DATABASE_URL=postgresql+asyncpg://sigv:sigv@localhost:5432/sigv
DB_ECHO=false

# --- Redis / Celery (non utilisés à ce stade, voir ARCHITECTURE_DECISIONS.md ADR-002) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Sécurité / JWT ---
# OBLIGATOIRE en production. Générez une clé forte :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-dev-secret-key
JWT_ALGORITHM=HS256
# Court : l'access token accompagne chaque requête. Sa brièveté est invisible pour
# l'agent tant que le client renouvelle en silence via POST /auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Durée d'une session sur l'appareil. Le poste d'accueil tourne toute la journée :
# une reconnexion hebdomadaire était une gêne inutile.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Renouvellement glissant : passé la moitié de sa vie, le refresh token est remplacé
# lors d'un rafraîchissement. Un agent qui utilise l'app n'est jamais déconnecté ;
# un appareil laissé de côté voit sa session expirer d'elle-même.
REFRESH_TOKEN_SLIDING=true

# --- CORS ---
# Origines autorisées séparées par des virgules. "*" est refusé en production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Exposition (voir DEPLOYMENT.md) ---
# Noms d'hôte acceptés ; "*" désactive le contrôle. Renseignez le domaine réel en production.
TRUSTED_HOSTS=*
# Préfixe ajouté par un reverse proxy montant l'API sous un sous-chemin.
ROOT_PATH=
# Vide = automatique : /docs exposé hors production, masqué en production.
ENABLE_DOCS=
# Vide = automatique : l'API sert storage/uploads hors production, le proxy s'en charge en production.
SERVE_STORAGE=

# --- Stockage fichiers ---
STORAGE_DIR=storage/uploads
STORAGE_PUBLIC_BASE_URL=/storage/uploads
MAX_UPLOAD_SIZE_MB=10

# --- OCR ---
OCR_USE_GPU=false
OCR_LANG=en
# Charge le modèle PaddleOCR au démarrage plutôt qu'à la première requête.
OCR_PRELOAD_MODEL=true
# Fraction haute de l'image ignorée lors du repli sur la bande basse du document.
OCR_MRZ_BAND_TOP_RATIO=0.5
# Modèles « mobile » : 3x plus rapides que les « medium » sur CPU, à qualité de
# lecture MRZ identique (voir ADR-013).
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=PP-OCRv5_mobile_rec
# oneDNN est cassé dans PaddlePaddle 3.3 sous Windows : toute inférence échoue.
# À repasser à true seulement sur un build où l'accélération CPU fonctionne.
OCR_ENABLE_MKLDNN=false

# --- Seed (développement uniquement) ---
SEED_AGENT_PASSWORD=Sigv@2026
