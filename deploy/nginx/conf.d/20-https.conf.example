# Serveur HTTPS — à activer une fois le certificat émis :
#
#   sudo cp deploy/nginx/conf.d/20-https.conf.example /etc/nginx/conf.d/20-https.conf
#   sudo sed -i 's/api.exemple.sn/votre.domaine.sn/g' /etc/nginx/conf.d/20-https.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Pensez ensuite à remplacer, dans `10-http.conf`, l'inclusion de `sigv-app.inc`
# par une redirection : `location / { return 301 https://$host$request_uri; }`.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.exemple.sn;

    ssl_certificate     /etc/letsencrypt/live/api.exemple.sn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.exemple.sn/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SIGV_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 180 jours : à ne monter à 2 ans qu'une fois le renouvellement automatique
    # éprouvé — un HSTS trop long est irréversible côté navigateur.
    add_header Strict-Transport-Security "max-age=15552000" always;

    client_max_body_size 12m;

    include /etc/nginx/conf.d/sigv-app.inc;
}
