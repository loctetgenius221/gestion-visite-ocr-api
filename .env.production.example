# Modèle de configuration pour un déploiement VPS.
#
#   cp .env.production.example .env
#
# Puis renseignez les valeurs marquées « À REMPLIR ». Ce fichier est lu par
# l'application (pydantic-settings) et par systemd (`EnvironmentFile`).
#
# Droits obligatoires sur le VPS :  chmod 600 .env  (il contient les secrets)

# --- Général ---
PROJECT_NAME="SIGV Backend"
# `production` active les garde-fous : refus de démarrer avec une clé JWT
# d'exemple ou un CORS permissif, documentation masquée, stockage servi par nginx.
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true

# --- Base de données ---
# À REMPLIR — mot de passe long et aléatoire, généré avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Attention : un mot de passe contenant @ ou : doit être encodé en pourcent.
DATABASE_URL=postgresql+asyncpg://sigv:MOT_DE_PASSE@localhost:5432/sigv
DB_ECHO=false

# --- Sécurité / JWT ---
# À REMPLIR — la changer invalide tous les jetons émis :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Session de 30 jours, glissante tant que l'appareil sert : l'agent du poste
# d'accueil n'est pas renvoyé à l'écran de connexion en pleine journée.
# Ce qui coupe une session : déconnexion volontaire, révocation par un
# administrateur, désactivation du compte, réinitialisation du mot de passe.
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_SLIDING=true

# --- Exposition ---
# À REMPLIR — domaine servi par nginx. Toute requête portant un autre en-tête
# `Host` est rejetée. Mettez "*" seulement si vous servez sur IP nue.
TRUSTED_HOSTS=api.exemple.sn
# Origines autorisées pour Flutter Web ou un back-office. Sans client web,
# laissez la valeur vide. "*" est refusé en production.
CORS_ORIGINS=https://app.exemple.sn
# Documentation interactive : masquée par défaut en production. `true` la rouvre
# le temps d'une recette — n'oubliez pas de la refermer.
ENABLE_DOCS=false
# Laissé à false : nginx sert `storage/uploads` directement depuis le volume.
SERVE_STORAGE=false
ROOT_PATH=

# --- Stockage fichiers ---
STORAGE_DIR=storage/uploads
STORAGE_PUBLIC_BASE_URL=/storage/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Dimensionnement (lu par uvicorn et par les bibliothèques d'inférence) ---
# Chaque worker charge sa propre copie du modèle PaddleOCR (~1,2 Go) : 2 workers
# demandent ~3 Go de RAM. Sur un VPS à 2 Go, passez à 1.
WEB_CONCURRENCY=2
# Threads d'inférence par worker. WEB_CONCURRENCY × OMP_NUM_THREADS ne doit pas
# dépasser le nombre de vCPU, sinon les workers se volent le CPU pendant un scan.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2

# --- OCR ---
OCR_USE_GPU=false
OCR_LANG=en
OCR_PRELOAD_MODEL=true
OCR_MRZ_BAND_TOP_RATIO=0.5
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=PP-OCRv5_mobile_rec
# oneDNN n'est cassé que sur le build Windows : sur l'image Linux, l'activer
# accélère nettement l'inférence CPU. Repassez à false en cas d'erreur au scan.
OCR_ENABLE_MKLDNN=true

# --- Redis / Celery (non utilisés à ce stade, voir ADR-002) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Seed initial ---
# Mot de passe des comptes créés par `python -m app.seeds`. En production, le
# seed refuse de s'exécuter tant que cette valeur est vide, trop courte (< 12
# caractères) ou égale au mot de passe de démonstration.
SEED_AGENT_PASSWORD=
